# Dev server settings for docker-compose.dev.yml / deploy-dev.sh.
# Copy to .env on the VM (`cp .env.example .env`) and fill in every value.
# .env is gitignored -- never commit it.
# Values must not contain spaces or quotes. Generate secrets with:
#   openssl rand -hex 32

SPRING_PROFILES_ACTIVE=dev

# Public API domain (Caddy issues its TLS certificate) and the frontend
# origin allowed by CORS. QR links also point at FRONTEND_ORIGIN.
API_DOMAIN=api-dev.washon.com
FRONTEND_ORIGIN=https://dev.washon.com

# MariaDB
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Admin session token signing key
ADMIN_SESSION_SECRET=

# MQTT (mosquitto). Account names are fixed: washon-backend, washon-camera.
MQTT_BACKEND_PASSWORD=
MQTT_CAMERA_PASSWORD=

# JVM heap cap for the backend container
JAVA_TOOL_OPTIONS=-Xmx512m
